# Neon PostgreSQL connection string (Vercel Storage integration).
# POSTGRES_URL is preferred; DATABASE_URL is accepted as a fallback.
POSTGRES_URL=

# Optional alias; use this if the database provider exposes DATABASE_URL instead.
DATABASE_URL=

# Neon Object Storage credentials from `neon env pull`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Only needed while legacy files still reference Vercel Blob.
BLOB_READ_WRITE_TOKEN=
